# Auto detect text files and perform LF normalization
* text=auto

# Runtime fleet data and editable/exported mesh assets belong in LFS.
**/battle-fleet.bin filter=lfs diff=lfs merge=lfs -text
**/flight-fleet.bin filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text

# The archived renderer is verified byte-for-byte, including original newlines.
opendesign/mockups/galactic-command/legacy-webgl/** -text -whitespace
# Bundled dependency formatting is generated by esbuild, not edited by hand.
*.bundle.js -whitespace
